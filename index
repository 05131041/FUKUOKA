            // Day 6: 小倉城 / 唐戶市場 / 門司港
            { id: '23', day: 6, time: '09:30', title: '唐戶市場 (Karato Market)', category: '美食', gmap: 'https://maps.google.com/?cid=7791985743706569026', lat: 33.9575, lng: 130.9472, desc: '位於下關的海鮮聖地！週末有熱鬧握壽司市集，現切河豚刺身。', price: '約 2,000日圓' },
            { id: '24', day: 6, time: '11:30', title: '門司港懷舊區 (Mojiko)', category: '景點', gmap: 'https://maps.app.goo.gl/mojiko', lat: 33.9458, lng: 130.9608, desc: '保留明治至大正時代歐式建築，藍翼門司吊橋音樂開橋秀。', price: '免費參觀' },
            { id: '25', day: 6, time: '13:00', title: '伽哩本鋪 門司港店 (燒咖哩)', category: '美食', gmap: 'https://maps.app.goo.gl/curryhonpo', lat: 33.9468, lng: 130.9615, desc: '門司港名物「燒咖哩」，焗烤香濃起司搭配半熟蛋與濃郁咖哩。', price: '約 1,400日圓' },
            { id: '26', day: 6, time: '15:30', title: '小倉城 (Kokura Castle)', category: '景點', gmap: 'https://maps.google.com/?cid=1371327252959948136', lat: 33.8834, lng: 130.8753, desc: '北九州唯一的名城，天守閣可俯瞰市區景緻。', price: '門票 350日圓' },

            // Day 7: 太宰府
            { id: '27', day: 7, time: '09:30', title: '太宰府天滿宮', category: '景點', gmap: 'https://maps.google.com/?cid=13268960937318002327', lat: 33.5215, lng: 130.5349, desc: '祈求學業與智慧的名神社，參道漫步感受古色古香街道。', price: '免費參觀' },
            { id: '28', day: 7, time: '10:45', title: '寶滿宮 竈門神社', category: '景點', gmap: 'https://maps.google.com/?cid=1612711681283628434', lat: 33.5385, lng: 130.5481, desc: '著名的結緣神社與賞楓名所，設計現代優雅。', price: '免費參觀' },
            { id: '29', day: 7, time: '12:00', title: 'かさの家 梅枝餅', category: '甜點', gmap: 'https://maps.app.goo.gl/kasanoya', lat: 33.5208, lng: 130.5312, desc: '太宰府必吃現烤熱騰騰「梅枝餅」，外皮酥脆內餡紅豆香甜。', price: '150日圓/個' },
            { id: '30', day: 7, time: '12:30', title: '暖暮拉麵 太宰府站前店', category: '美食', gmap: 'https://maps.app.goo.gl/danbo', lat: 33.5186, lng: 130.5280, desc: '曾榮獲九州拉麵總選舉第一名！豚骨湯頭順口濃厚。', price: '約 900日圓' },

            // Day 8: 柳橋市場 / 台灣
            { id: '31', day: 8, time: '09:00', title: '柳橋連合市場', category: '美食', gmap: 'https://maps.google.com/?cid=102830192831', lat: 33.5833, lng: 130.4069, desc: '被稱為「博多的廚房」，品嚐鮮魚生魚片丼飯與炸魚餅。', price: '約 1,500日圓' },
            { id: '32', day: 8, time: '11:00', title: '博多車站伴手禮採買', category: '購物', gmap: 'https://maps.app.goo.gl/hakatastation', lat: 33.5897, lng: 130.4207, desc: '採買明太子、福太郎仙貝、博多通饅頭、博多甘王草莓餅乾。', price: '自由採買' },
            { id: '33', day: 8, time: '13:30', title: '福岡機場 (返台)', category: '交通', gmap: 'https://maps.app.goo.gl/fukuokaairport', lat: 33.5859, lng: 130.4442, desc: '滿載美味回憶準備搭機返回台灣！', price: '-' }
        ];

        // Global State Variables
        let activeDay = 'all';
        let activeCategory = 'all';
        let searchQuery = '';
        let map;
        let markers = [];

        // Aesthetic Warm Sage & Terracotta Category Mapping
        const categoryConfig = {
            '景點': { bg: 'bg-[#EBF0E8]', text: 'text-[#5A704F]', border: 'border-[#CDD7C6]', icon: 'fa-leaf', color: '#738C67' },
            '美食': { bg: 'bg-[#F8EFEA]', text: 'text-[#C27355]', border: 'border-[#F0D8CD]', icon: 'fa-utensils', color: '#C27355' },
            '甜點': { bg: 'bg-[#F7EEF0]', text: 'text-[#BA7B88]', border: 'border-[#EBD6DC]', icon: 'fa-cookie-bite', color: '#BA7B88' },
            '購物': { bg: 'bg-[#F8F3EA]', text: 'text-[#B88F51]', border: 'border-[#EFE2CD]', icon: 'fa-bag-shopping', color: '#B88F51' },
            '交通': { bg: 'bg-[#EBF2F0]', text: 'text-[#627D75]', border: 'border-[#CCDCD7]', icon: 'fa-bus', color: '#627D75' }
        };

        // Initialize Map
        function initMap() {
            map = L.map('map', {
                zoomControl: true,
                scrollWheelZoom: true
            }).setView([33.5902, 130.4207], 11);

            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap & CartoDB',
                subdomains: 'abcd',
                maxZoom: 19
            }).addTo(map);

            renderListAndMap();
        }

        // Custom SVG Pin Marker
        function createCustomPin(color) {
            const svgPin = `
                <div style="filter: drop-shadow(0px 3px 5px rgba(54,49,40,0.25));">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="${color}" width="30" height="30">
                        <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                    </svg>
                </div>`;
            return L.divIcon({
                html: svgPin,
                className: 'custom-div-icon',
                iconSize: [30, 30],
                iconAnchor: [15, 30],
                popupAnchor: [0, -28]
            });
        }

        function renderListAndMap() {
            const listContainer = document.getElementById('itinerary-list');
            listContainer.innerHTML = '';

            // Reset Markers
            markers.forEach(m => map.removeLayer(m));
            markers = [];

            // Filter logic
            const filtered = itineraryItems.filter(item => {
                const matchDay = (activeDay === 'all') || (item.day == activeDay);
                const matchCat = (activeCategory === 'all') || (item.category === activeCategory);
                const matchQuery = !searchQuery || 
                    (item.title && item.title.toLowerCase().includes(searchQuery.toLowerCase())) ||
                    (item.desc && item.desc.toLowerCase().includes(searchQuery.toLowerCase()));
                return matchDay && matchCat && matchQuery;
            });

            document.getElementById('item-count').textContent = filtered.length;

            if (filtered.length === 0) {
                listContainer.innerHTML = `
                    <div class="text-center py-12 text-beige-400">
                        <i class="fa-solid fa-compass text-3xl mb-2 text-beige-300"></i>
                        <p class="text-xs">沒有找到符合條件的地點</p>
                    </div>`;
                return;
            }

            const bounds = [];

            filtered.forEach(item => {
                const catInfo = categoryConfig[item.category] || categoryConfig['景點'];

                // Render Card HTML
                const card = document.createElement('div');
                card.className = `p-3 rounded-2xl border ${catInfo.border} bg-white shadow-xs hover:shadow-md transition-all duration-200 active:scale-[0.99] cursor-pointer flex flex-col space-y-1.5 group`;
                card.onclick = () => focusLocation(item.lat, item.lng, item.id);

                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-1.5">
                            <span class="text-[10px] px-2 py-0.5 rounded-md ${catInfo.bg} ${catInfo.text} font-medium flex items-center">
                                <i class="fa-solid ${catInfo.icon} mr-1 text-[9px]"></i>${item.category}
                            </span>
                            <span class="text-[10px] font-medium text-beige-800/70 bg-beige-100 px-1.5 py-0.5 rounded-md">
                                Day ${item.day} · ${item.time || '時間未定'}
                            </span>
                        </div>
                    </div>

                    <div>
                        <h3 class="font-serif font-bold text-beige-900 text-sm group-hover:text-sage-700 transition-colors">
                            ${item.title}
                        </h3>
                        ${item.desc ? `<p class="text-xs text-beige-800/70 mt-0.5 line-clamp-2 leading-relaxed">${item.desc}</p>` : ''}
                    </div>

                    <div class="flex items-center justify-between pt-1 border-t border-beige-100 text-xs">
                        <span class="text-[11px] text-beige-800/60 font-medium">${item.price ? `<i class="fa-regular fa-money-bill-1 mr-1"></i>${item.price}` : ''}</span>
                        <a href="${item.gmap}" target="_blank" onclick="event.stopPropagation()" class="inline-flex items-center space-x-1 text-[11px] text-sage-700 font-semibold bg-sage-50 hover:bg-sage-100 px-2.5 py-1 rounded-lg transition-colors border border-sage-200/50">
                            <i class="fa-solid fa-location-arrow text-[10px]"></i>
                            <span>Google 地圖導航</span>
                        </a>
                    </div>
                `;

                listContainer.appendChild(card);

                // Add Leaflet Marker
                if (item.lat && item.lng) {
                    const markerPin = createCustomPin(catInfo.color);
                    const marker = L.marker([item.lat, item.lng], { icon: markerPin }).addTo(map);

                    const popupContent = `
                        <div class="p-2 max-w-[220px]">
                            <div class="flex items-center space-x-1 mb-1">
                                <span class="text-[9px] px-1.5 py-0.5 rounded ${catInfo.bg} ${catInfo.text} font-medium">D${item.day} ${item.category}</span>
                                <span class="text-[10px] font-medium text-beige-800/70">${item.time || ''}</span>
                            </div>
                            <h4 class="font-serif font-bold text-xs text-beige-900">${item.title}</h4>
                            <p class="text-[11px] text-beige-800/70 my-1 line-clamp-2">${item.desc || ''}</p>
                            <a href="${item.gmap}" target="_blank" class="mt-2 inline-block w-full text-center bg-sage-600 text-white text-xs font-medium py-1.5 px-3 rounded-xl hover:bg-sage-700 transition">
                                <i class="fa-solid fa-map-location-dot mr-1"></i>開 Google 地圖導航
                            </a>
                        </div>
                    `;

                    marker.bindPopup(popupContent);
                    marker.itemId = item.id;
                    markers.push(marker);
                    bounds.push([item.lat, item.lng]);
                }
            });

            if (bounds.length > 0) {
                map.fitBounds(bounds, { padding: [25, 25], maxZoom: 14 });
            }
        }

        function filterDay(day) {
            activeDay = day;
            document.querySelectorAll('.day-btn').forEach(btn => {
                if (btn.dataset.day == day) {
                    btn.className = 'day-btn snap-start px-3 py-1.5 rounded-xl bg-sage-600 text-white font-medium whitespace-nowrap shadow-xs transition active:scale-95 shrink-0';
                } else {
                    btn.className = 'day-btn snap-start px-3 py-1.5 rounded-xl bg-white text-beige-800 hover:bg-beige-100 border border-beige-200 whitespace-nowrap transition active:scale-95 shrink-0';
                }
            });
            renderListAndMap();
        }

        function filterCategory(cat) {
            activeCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.dataset.cat == cat) {
                    btn.classList.add('ring-2', 'ring-sage-500', 'font-semibold');
                } else {
                    btn.classList.remove('ring-2', 'ring-sage-500', 'font-semibold');
                }
            });
            renderListAndMap();
        }

        function handleSearch() {
            searchQuery = document.getElementById('search-input').value.trim();
            const clearBtn = document.getElementById('search-clear-btn');
            if (searchQuery) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }
            renderListAndMap();
        }

        function clearSearch() {
            document.getElementById('search-input').value = '';
            handleSearch();
        }

        function focusLocation(lat, lng, itemId) {
            if (window.innerWidth < 768) {
                switchMobileTab('map');
            }
            if (lat && lng) {
                setTimeout(() => {
                    map.flyTo([lat, lng], 15, { duration: 1 });
                    const marker = markers.find(m => m.itemId === itemId);
                    if (marker) {
                        marker.openPopup();
                    }
                }, 100);
            }
        }

        function resetMapView() {
            renderListAndMap();
        }

        function switchMobileTab(tab) {
            const listPane = document.getElementById('list-pane');
            const mapPane = document.getElementById('map-pane');
            const navBtnList = document.getElementById('nav-btn-list');
            const navBtnMap = document.getElementById('nav-btn-map');

            if (tab === 'list') {
                listPane.classList.remove('hidden');
                mapPane.classList.add('hidden');
                navBtnList.className = 'flex flex-col items-center justify-center w-24 py-1 text-sage-700 font-bold transition active:scale-95';
                navBtnMap.className = 'flex flex-col items-center justify-center w-24 py-1 text-beige-400 font-medium transition active:scale-95';
            } else {
                listPane.classList.add('hidden');
                mapPane.classList.remove('hidden');
                mapPane.classList.add('flex');
                navBtnList.className = 'flex flex-col items-center justify-center w-24 py-1 text-beige-400 font-medium transition active:scale-95';
                navBtnMap.className = 'flex flex-col items-center justify-center w-24 py-1 text-sage-700 font-bold transition active:scale-95';
                setTimeout(() => map.invalidateSize(), 200);
            }
        }

        window.onload = function () {
            initMap();
        };
    </script>
</body>
</html>
